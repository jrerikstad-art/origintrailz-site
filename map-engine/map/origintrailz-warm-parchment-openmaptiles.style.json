{
  "version": 8,
  "name": "Warm Parchment Premium (OpenMapTiles)",
  "metadata": {
    "origintrailz:theme": "Warm Parchment Premium",
    "origintrailz:schema": "openmaptiles",
    "origintrailz:tiles": "OpenFreeMap (global)"
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "terrain": {
      "type": "raster-dem",
      "tiles": [
        "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
      ],
      "encoding": "terrarium",
      "tileSize": 256,
      "maxzoom": 15
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#c6beab"
      }
    },
    {
      "id": "landcover-forest",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": {
        "fill-color": "#9ca88a",
        "fill-opacity": 0.52,
        "fill-antialias": false
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["grass", "wetland"]]],
      "paint": {
        "fill-color": "#abb79a",
        "fill-opacity": 0.38,
        "fill-antialias": false
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#a1ad8e",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "sand"],
      "paint": {
        "fill-color": "#cfc6b0",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {
        "fill-color": "#b8c9d8",
        "fill-opacity": 1
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "layout": { "line-cap": "round" },
      "paint": {
        "line-color": "#b8c9d8",
        "line-width": [
          "interpolate", ["exponential", 1.3], ["zoom"],
          11, 0.6, 20, 5
        ]
      }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "terrain",
      "paint": {
        "hillshade-exaggeration": 0.55,
        "hillshade-illumination-direction": 315,
        "hillshade-shadow-color": "#4a3f35",
        "hillshade-highlight-color": "#d8d0bc",
        "hillshade-accent-color": "#6b5a48"
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "brunnel"], ["tunnel"], false, true],
        ["match", ["get", "class"],
          ["motorway", "trunk", "primary", "secondary", "tertiary", "minor"],
          true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#8c6f4a",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          8, 1.2, 12, 3, 16, 8
        ]
      }
    },
    {
      "id": "roads-path-glow",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["path", "pedestrian", "track"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffe8b3",
        "line-blur": 2.5,
        "line-opacity": 0.55,
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          12, 3, 16, 9
        ]
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "brunnel"], ["tunnel"], false, true],
        ["match", ["get", "class"], ["minor", "service"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#c19e60",
        "line-opacity": 0.82,
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          10, 0.6, 14, 2, 17, 6
        ]
      }
    },
    {
      "id": "roads-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["match", ["get", "brunnel"], ["tunnel"], false, true],
        ["match", ["get", "class"], ["secondary", "tertiary"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#e6c06f",
        "line-opacity": 0.95,
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          9, 0.8, 13, 2.5, 17, 8
        ]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["match", ["get", "brunnel"], ["tunnel"], false, true],
        ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#e8c070",
        "line-opacity": 1,
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          7, 1, 12, 3.5, 16, 10
        ]
      }
    },
    {
      "id": "roads-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["path", "pedestrian", "track"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffe8b3",
        "line-opacity": 0.88,
        "line-dasharray": [2, 1.5],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          12, 0.8, 16, 2.5
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          ["linear"],
          ["coalesce", ["get", "render_height"], ["get", "height"], 10],
          0, "#dcc4a8",
          20, "#d4b89a",
          50, "#c4a688"
        ],
        "fill-extrusion-height": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14, 0,
          14.5, [
            "coalesce",
            ["get", "render_height"],
            ["get", "height"],
            ["*", ["coalesce", ["get", "levels"], ["get", "building:levels"], 2], 3],
            8
          ]
        ],
        "fill-extrusion-base": [
          "coalesce",
          ["get", "render_min_height"],
          ["get", "min_height"],
          0
        ],
        "fill-extrusion-opacity": 0.92,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "labels-places",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "match",
        ["get", "class"],
        ["city", "town", "village", "suburb", "neighbourhood", "hamlet"],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:en"],
          ["get", "name:latin"],
          ["get", "name"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          6, 11, 12, 14, 16, 18
        ],
        "text-max-width": 8,
        "text-padding": 2
      },
      "paint": {
        "text-color": "#3f2e22",
        "text-halo-color": "#c6beab",
        "text-halo-width": 1.4
      }
    }
  ]
}
